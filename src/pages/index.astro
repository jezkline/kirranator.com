---
// The kirranator.com landing page: the typed-text banner loops fullscreen
// and the whole page links to the Yapper docs.
// It's a GIF on purpose. Browsers color-manage video differently from CSS,
// so an MP4's green never quite matches the page and shows a visible band.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kirranator</title>
<meta name="description" content="kirranator — modular dev systems">
<meta name="theme-color" content="#84c59d">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style is:global>
  :root { --bg: #84c59d; --fg: #ffffff; }
  * { margin: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body { background: var(--bg); overflow: hidden; }
  a.stage { position: fixed; inset: 0; display: block; }
  /* contain, not cover: the banner's own background is the page green,
     so the letterbox disappears and the text never gets cropped. */
  a.stage img { width: 100%; height: 100%; object-fit: contain; display: block; }
  a.stage:focus-visible { outline: 4px solid var(--fg); outline-offset: -12px; border-radius: 12px; }
</style>
</head>
<body>
  <a class="stage" href="/yapper/">
    <picture>
      <source srcset="/bg-still.png" media="(prefers-reduced-motion: reduce)">
      <img src="/bg-loop.gif" width="1950" height="1300" alt="kirranator: modular dev systems. Yapper, decision-tree builder.">
    </picture>
  </a>
</body>
</html>
